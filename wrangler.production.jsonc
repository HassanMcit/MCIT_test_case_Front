{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcit-test-case-front-prod",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "MCIT_CLOUDFLARE": "true",
    "NEXT_PUBLIC_APP_ENV": "production",
    "AUTH_TRUST_HOST": "true",
    "AUTH_URL": "https://mcit-test-case-front-prod.mcit-gov.workers.dev",
    "NEXT_PUBLIC_BASE_URL": "https://mcit-test-case-backend.onrender.com"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mcit-test-case-front-prod"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4833299ec13744618387b482c9298a20"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "67158385283a4052a3a72a91df8baa03"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
