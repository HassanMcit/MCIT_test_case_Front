{
  "name": "mcit-test-case-front",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test:projects": "node --test test/project-cache.test.cjs test/schedule-picker.test.cjs test/eligible-users.test.cjs",
    "test:layout": "node test/layout-overflow.cjs",
    "test:performance": "node --test test/performance-cache.test.cjs",
    "test:performance:browser": "node test/performance-browser.cjs",
    "cf:build": "opennextjs-cloudflare build --config=wrangler.jsonc",
    "cf:build:staging": "opennextjs-cloudflare build --config=wrangler.staging.jsonc",
    "cf:build:prod": "opennextjs-cloudflare build --config=wrangler.production.jsonc",
    "cf:preview": "opennextjs-cloudflare preview --config=wrangler.jsonc",
    "cf:deploy": "opennextjs-cloudflare deploy --config=wrangler.jsonc",
    "cf:deploy:staging": "opennextjs-cloudflare deploy --config=wrangler.staging.jsonc",
    "cf:deploy:prod": "opennextjs-cloudflare deploy --config=wrangler.production.jsonc",
    "cf:check": "wrangler deploy --config=wrangler.jsonc --dry-run --outdir .cloudflare-dry-run",
    "cf:check:staging": "wrangler deploy --config=wrangler.staging.jsonc --dry-run --outdir .cloudflare-dry-run",
    "cf:check:prod": "wrangler deploy --config=wrangler.production.jsonc --dry-run --outdir .cloudflare-prod-dry-run",
    "test:cloudflare": "node --test test/cloudflare-*.test.cjs",
    "cf:build:windows": "node --require ./scripts/cloudflare-windows-junctions.cjs ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build --config=wrangler.staging.jsonc",
    "cf:build:prod:windows": "node --require ./scripts/cloudflare-windows-junctions.cjs ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build --config=wrangler.production.jsonc",
    "cf:typegen": "wrangler types cloudflare-bindings.d.ts --env-interface CloudflareBindings --include-runtime=false",
    "test:unit": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/stitch-sdk": "^0.3.5",
    "@hookform/resolvers": "^5.9.1",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "rclone.js": "0.6.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.158.0"
  }
}
